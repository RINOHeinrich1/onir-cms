{
  "name": "onir-cms",
  "version": "0.20.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/db/migrate.cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/infrastructure/db/seed-admin.cli.ts",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo-links.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:verify-tenant": "tsx --env-file-if-exists=.env src/infrastructure/db/verify-tenant.ts",
    "test:e2e": "playwright test",
    "build:db-cli": "node scripts/build-db-cli.mjs",
    "check:fast": "npm run typecheck && npm run lint && npm run build",
    "check:full": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build",
    "db:backup": "tsx --env-file-if-exists=.env src/infrastructure/db/backup-database.cli.ts",
    "db:reset-all-chatbot-data": "tsx --env-file-if-exists=.env src/infrastructure/db/reset-chatbot-test-data.cli.ts",
    "db:audit-legacy": "tsx --env-file-if-exists=.env src/infrastructure/db/audit-legacy-chatbots.cli.ts",
    "db:plan-legacy": "tsx --env-file-if-exists=.env src/infrastructure/db/plan-legacy-chatbot-migration.cli.ts",
    "db:migrate-legacy": "tsx --env-file-if-exists=.env src/infrastructure/db/migrate-legacy-chatbot.cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fflate": "^0.8.3",
    "next": "^16.4.2",
    "officeparser": "^8.2.0",
    "pdfkit": "^0.20.2",
    "pg": "^8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "robots-parser": "^3.0.1",
    "swagger-ui-dist": "^5.34.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "ONIR CMS — open-source AI prospecting and conversation CMS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RINOHeinrich1/onir-cms.git"
  },
  "homepage": "https://github.com/RINOHeinrich1/onir-cms#readme",
  "bugs": {
    "url": "https://github.com/RINOHeinrich1/onir-cms/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "RINO Heinrich",
  "keywords": [
    "cms",
    "ai",
    "prospecting",
    "nextjs",
    "postgresql",
    "self-hosted",
    "open-source"
  ]
}
