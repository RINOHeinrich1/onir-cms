# ============================================================================
# ONIR CMS — variables d'environnement
# Copier vers `.env` (gitignoré) et renseigner les valeurs réelles.
# AUCUN secret ne doit être commité.
# ============================================================================

# --- Base de données PostgreSQL dédiée (cf. docker-compose.yml, port 5433) ---
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://onir_cms:CHANGE_ME@127.0.0.1:5433/onir_cms

# --- Base jetable des tests d'intégration (JAMAIS la production) ---
# Le nom doit contenir « test » (garde-fou du harnais).
TEST_DATABASE_URL=postgres://onir_cms:CHANGE_ME@127.0.0.1:5433/onir_cms_test

# --- Lecture des ressources de données des templates (ADR-0026) ---
# OPTIONNEL : par défaut, le compte de lecture est géré/chiffré depuis le panneau
# super-admin (Templates visuels → Compte de lecture des données).
# Cette variable est une SURCHARGE d'exploitation (rôle externe) et a priorité.
# TEMPLATE_DATABASE_URL=postgres://template_reader_login:CHANGE_ME@127.0.0.1:5433/onir_cms

# --- Stockage média (photos importées) ---
# Défaut : <racine du projet>/var/media. Doit être persistant et inscriptible.
# MEDIA_DIR=/srv/onir-cms/media
# Pièces jointes de prospection (défaut : MEDIA_DIR/attachments).
# ATTACHMENTS_DIR=/srv/onir-cms/attachments

# --- Session ---
# Secret de signature/robustesse (chaîne aléatoire longue, ex. `openssl rand -hex 32`)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# --- Application ---
APP_URL=http://localhost:3000
# Domaine public des liens/widgets (facultatif, défaut APP_URL)
PUBLIC_LINK_BASE_URL=http://localhost:3000

# --- Compte administrateur par défaut (mot de passe HASHÉ en base) ---
# Créé par `npm run db:seed` avec rotation forcée à la première connexion.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- IA : fournisseurs OpenAI-compatible (ADR-0029) ---
# Chiffrement des clés API stockées en base. 64 hex : `openssl rand -hex 32`.
AI_PROVIDER_KEY=CHANGE_ME_64_HEX
# Autorise un fournisseur local sur réseau privé (HTTP/loopback) en dev/on-prem.
AI_ALLOW_PRIVATE_NETWORKS=false
# Configuration legacy Infomaniak : fallback tant qu'aucun défaut n'est défini.
AI_API_TOKEN=CHANGE_ME_AI_TOKEN
AI_PRODUCT_ID=CHANGE_ME_AI_PRODUCT_ID
AI_MODEL=Qwen/Qwen3.5-122B-A10B-FP8

# --- Liens partageables : chiffrement réversible des jetons (AES-256-GCM) ---
# 32 octets hex, ex. `openssl rand -hex 32`. Requis pour créer/copier un lien.
LINK_TOKEN_KEY=CHANGE_ME_64_HEX

# --- Secrets applicatifs (ADR-0036) ---
# Clé racine unique, 64 hex. Chiffre les secrets gérés dans /configuration.
# Après le premier démarrage, SESSION_SECRET/LINK_TOKEN_KEY/AI_PROVIDER_KEY/
# WEBHOOK_SECRET_KEY sont importés puis gérés depuis l'interface.
CONFIG_MASTER_KEY=CHANGE_ME_64_HEX

# --- Webhooks sortants (ADR-0035) ---
# 32 octets hex, ex. `openssl rand -hex 32`. Requis pour les webhooks authentifiés
# et les en-têtes/query marqués secrets. Distinct de SESSION_SECRET.
WEBHOOK_SECRET_KEY=CHANGE_ME_64_HEX
