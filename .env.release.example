# ============================================================================
# ONIR CMS — distribution GHCR
# Copier vers .env.release (gitignoré) et renseigner les valeurs.
# ============================================================================

# Version publiée sur GHCR (sans le préfixe v)
ONIR_CMS_VERSION=0.1.1

# --- PostgreSQL ---
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5435

# --- Application ---
APP_PORT=3000
APP_URL=http://localhost:3000
# Domaine public des liens/widgets (facultatif, défaut APP_URL)
PUBLIC_LINK_BASE_URL=http://localhost:3000
# Clé racine ADR-0036. Générer avec `openssl rand -hex 32`.
CONFIG_MASTER_KEY=change-me-64-hex
SESSION_SECRET=change-me-64-hex
LINK_TOKEN_KEY=change-me-64-hex
WEBHOOK_SECRET_KEY=change-me-64-hex

# --- Compte admin initial ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# --- IA : fournisseurs OpenAI-compatible (ADR-0029) ---
# Chiffrement des clés API stockées en base (64 hex). Requis pour /parametres/ia.
AI_PROVIDER_KEY=
AI_ALLOW_PRIVATE_NETWORKS=false
# Configuration legacy Infomaniak : fallback tant qu'aucun défaut n'est défini.
AI_API_TOKEN=
AI_PRODUCT_ID=
AI_MODEL=Qwen/Qwen3.5-122B-A10B-FP8

# --- Pièces jointes ---
# Défaut : /app/var/media/attachments (dans le volume media_data).
# ATTACHMENTS_DIR=/app/var/media/attachments
