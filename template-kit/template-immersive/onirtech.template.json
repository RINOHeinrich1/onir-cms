{
  "schemaVersion": 1,
  "kind": "template",
  "id": "immersive",
  "name": "Immersive",
  "description": "Scène 3D RÉALISTE : SAS d'entrée = MAISON 3D (murs brique, toit tuiles, porte bois — PBR + HDRI, assets CC0) avec FORMULAIRE CENTRÉ nom/email/consentement ; à la soumission la maison passe devant, la PORTE S'OUVRE, puis TRAVELLING CONTINU à travers la porte vers la SALLE (cabinet cohérent : lambris, bibliothèque, tapis, lustre ; PBR + HDRI) — livre FERMÉ (ouvre au clic pupitre). Scène « discussion » (rotation de la salle) : PERSONNAGE 3D réaliste via TalkingHead (avatar GLB, MIT ; personnage Microsoft RocketBox (MIT)), MUET — humeurs (neutre/content/triste) + gestes + mouvements de tête selon l'état du visiteur ; tableau image/connaissance/lien + dialogue texte à HAUTEUR FIXE (sans défilement : texte révélé progressivement, messages longs PAGINÉS en feuilletant avec ‹ ›). Bouton « Terminer » qui ouvre une MODALE de confirmation avant de générer la fiche, avec toast de confirmation ; composer compact en icônes sous mobile, avec import de pièces jointes (CV, documents) quand le modèle le demande. Extérieur CLOS : cour carrée clôturée (panneaux + piliers), portail bois entre deux piliers maçonnés, haie et rideau d'arbres, brume légère sur l'horizon. Ressources de données : contrat `library` (livres + pages) chargé via `ctx.data.load`, avec repli sur la médiathèque.",
  "version": "4.45.0",
  "publisher": {
    "id": "onirtech",
    "name": "ONIRTECH",
    "trustLevel": "official"
  },
  "compatibility": {
    "hostProtocol": "onirtech.template-host.v1"
  },
  "ui": {
    "mode": "web-component",
    "entry": "./src/index.js",
    "element": "onirtech-template-immersive",
    "integrity": "sha256-oMt4Skkroh7u8RfiktQp105oIc45fr4MoUMW92KRWAw=",
    "shadowDom": "open"
  },
  "capabilities": [
    "messages",
    "media",
    "theme",
    "userState",
    "knowledge",
    "data",
    "modelForm",
    "attachments"
  ],
  "network": [],
  "params": [
    {
      "key": "titre_de_livre",
      "label": "Titre du livre",
      "description": "Titre affiché sur la couverture de l'album",
      "type": "string",
      "default": "album",
      "maxLength": 60
    },
    {
      "key": "categorie",
      "label": "Catégorie de l'album",
      "description": "Texte de la catégorie utilisée pour construire l'album (paramètre du lien).",
      "type": "string",
      "default": "",
      "maxLength": 120
    }
  ],
  "data": {
    "contracts": [
      {
        "key": "library",
        "label": "Bibliothèque",
        "description": "Livres et pages affichés dans l'album 3D",
        "version": 1,
        "loading": "lazy",
        "inputs": [],
        "schema": {
          "type": "object",
          "required": [
            "books"
          ],
          "properties": {
            "books": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "pages": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "required": [
                        "index",
                        "text"
                      ],
                      "properties": {
                        "media_id": {
                          "type": "string",
                          "maxLength": 64
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "image": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "key": "album",
        "label": "Album",
        "description": "Pages du livre posé sur le pupitre",
        "version": 1,
        "loading": "lazy",
        "inputs": [],
        "schema": {
          "type": "object",
          "required": [
            "pages"
          ],
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "pages": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "media_id": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "image": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2000
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
