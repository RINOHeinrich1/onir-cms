{
  "schemaVersion": 1,
  "kind": "template",
  "id": "starter",
  "name": "Starter",
  "description": "Template de référence (identité, chat, médias) avec un widget de discussion soigné.",
  "version": "1.5.0",
  "publisher": {
    "id": "onirtech",
    "name": "ONIRTECH",
    "trustLevel": "official"
  },
  "compatibility": {
    "hostProtocol": "onirtech.template-host.v1"
  },
  "ui": {
    "mode": "web-component",
    "entry": "./src/index.js",
    "element": "onirtech-template-starter",
    "integrity": "sha256-mKz3UoKXu/lkcAbZNd8pc2nNo8i9La2/UvdZxjKqayA=",
    "shadowDom": "open",
    "widget": {
      "entry": "./src/widget.js",
      "element": "onirtech-widget-starter",
      "integrity": "sha256-9J0Y1+VORRwX2srEkqGNjTMPUmeXR1qAXOCK7U+3tCA=",
      "display": {
        "defaultPosition": "bottom-right",
        "allowedPositions": [
          "bottom-right",
          "bottom-left"
        ],
        "closedSize": {
          "width": 64,
          "height": 64
        },
        "openSize": {
          "width": 420,
          "height": 680
        },
        "maxSize": {
          "width": 520,
          "height": 760
        }
      }
    }
  },
  "capabilities": [
    "messages",
    "media",
    "theme",
    "fallback"
  ],
  "network": [],
  "params": [
    {
      "key": "chat_title",
      "label": "Titre du chatbot",
      "description": "Nom affiché en haut du widget.",
      "type": "string",
      "default": "ONIRTECH",
      "maxLength": 80
    },
    {
      "key": "welcome_title",
      "label": "Titre de bienvenue",
      "description": "Titre affiché dans le message d'accueil.",
      "type": "string",
      "default": "Bienvenue",
      "maxLength": 80
    },
    {
      "key": "welcome_message",
      "label": "Message de bienvenue",
      "description": "Texte affiché sous le titre d'accueil.",
      "type": "text",
      "default": "Décrivez votre demande. Je vous réponds directement ici.",
      "maxLength": 300
    },
    {
      "key": "primary_color",
      "label": "Couleur principale",
      "description": "En-tête, launcher, bulle visiteur et bouton d'envoi.",
      "type": "color",
      "default": "#023777"
    },
    {
      "key": "accent_color",
      "label": "Couleur d'accent",
      "description": "Liens, focus, badges et petits accents.",
      "type": "color",
      "default": "#fcad28"
    },
    {
      "key": "launcher_icon_color",
      "label": "Couleur de l'icône du chatbot",
      "description": "Couleur du pictogramme dans le bouton flottant.",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "background_color",
      "label": "Fond de la conversation",
      "description": "Fond derrière les messages.",
      "type": "color",
      "default": "#f7f9fc"
    },
    {
      "key": "surface_color",
      "label": "Surface",
      "description": "Bulles de l'assistant, composeur et cartes.",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "text_color",
      "label": "Couleur du texte",
      "description": "Texte principal des messages et des champs.",
      "type": "color",
      "default": "#0f172a"
    },
    {
      "key": "muted_color",
      "label": "Texte secondaire",
      "description": "Horodatages, aides et libellés discrets.",
      "type": "color",
      "default": "#64748b"
    },
    {
      "key": "border_color",
      "label": "Bordures",
      "description": "Bordures des bulles, du composeur et des séparateurs.",
      "type": "color",
      "default": "#e2e8f0"
    }
  ]
}
