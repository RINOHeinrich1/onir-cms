{
  "schemaVersion": 1,
  "kind": "template",
  "id": "starter",
  "name": "Starter",
  "description": "Template de référence (identité, chat, médias) avec un widget de discussion soigné.",
  "version": "1.2.1",
  "publisher": {
    "id": "onirtech",
    "name": "ONIRTECH",
    "trustLevel": "official"
  },
  "compatibility": {
    "hostProtocol": "onirtech.template-host.v1"
  },
  "ui": {
    "mode": "web-component",
    "entry": "./src/index.js",
    "element": "onirtech-template-starter",
    "integrity": "sha256-HTyyn5uf8gvDZmFEvussLc1Dliuuyr3ZoVLYrjFspO0=",
    "shadowDom": "open",
    "widget": {
      "entry": "./src/widget.js",
      "element": "onirtech-widget-starter",
      "integrity": "sha256-0UaRB5R9fqKr5oPZXtC8fDRYPAO1Sgsyi6hJsMfDOFQ=",
      "display": {
        "defaultPosition": "bottom-right",
        "allowedPositions": [
          "bottom-right",
          "bottom-left"
        ],
        "closedSize": {
          "width": 64,
          "height": 64
        },
        "openSize": {
          "width": 420,
          "height": 680
        },
        "maxSize": {
          "width": 520,
          "height": 760
        }
      }
    }
  },
  "capabilities": [
    "messages",
    "media",
    "theme"
  ],
  "network": []
}
