# ============================================================================
# ONIR CMS — environnement Docker local
# Copier/générer avec : ./scripts/docker-dev-init.sh
# Ce fichier contient des placeholders : ne jamais y mettre de vrais secrets.
# ============================================================================

# --- PostgreSQL local (conteneur) ---
POSTGRES_PASSWORD=change-me-local

# --- Ports hôte (modifiables en cas de conflit) ---
APP_PORT=3000
POSTGRES_PORT=5434
ADMINER_PORT=8080

# --- Application ---
APP_URL=http://localhost:3000
# Domaine public des liens/widgets (facultatif, défaut APP_URL)
PUBLIC_LINK_BASE_URL=http://localhost:3000
# Clé racine ADR-0036 (générée par docker-dev-init).
CONFIG_MASTER_KEY=change-me-64-hex
SESSION_SECRET=change-me-64-hex
LINK_TOKEN_KEY=change-me-64-hex
WEBHOOK_SECRET_KEY=change-me-64-hex

# --- Compte admin initial (seed, rotation forcée à la première connexion) ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# --- IA : fournisseurs OpenAI-compatible (ADR-0029) ---
# Chiffrement des clés API stockées en base (64 hex). Requis pour /parametres/ia.
AI_PROVIDER_KEY=
AI_ALLOW_PRIVATE_NETWORKS=false
# Configuration legacy Infomaniak : fallback tant qu'aucun défaut n'est défini.
AI_API_TOKEN=
AI_PRODUCT_ID=
AI_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
